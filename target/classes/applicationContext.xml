<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->

	<bean name="emp1" class="com.learning.spring.model.Employee" autowire="byType">

		<property name="id" value="111" />
		<property name="name" value="Ashish" />
		<property name="gender" value="Male" />

	</bean>



	
	
	<bean name="add"  class="com.learning.spring.model.Address">
	
		<property name="city" value="Noida"/>
		<property name="state" value="UP"/>
	
	</bean>
	
	

</beans>

